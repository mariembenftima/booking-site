# Copy to .env and fill in. Never commit .env.

# Neon pooled connection string (host contains "-pooler"). NEVER the production database locally.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=verify-full

# Random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Vercel Blob (Vercel → Storage → your Blob store)
BLOB_READ_WRITE_TOKEN=

# Business time zone (IANA name)
BUSINESS_TIMEZONE=Africa/Tunis

# Resend (resend.com → API Keys)
RESEND_API_KEY=
EMAIL_FROM=Maison Sauge <onboarding@resend.dev>
# Optional: send owner notifications here instead of the Site settings email (Resend test mode)
OWNER_EMAIL=

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
